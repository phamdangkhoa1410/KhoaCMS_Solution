@{
    Layout = "_Layout"; // Nhúng bộ khung giao diện chính của hệ thống
    ViewData["Title"] = "403 - Từ chối truy cập";
}

<div class="container mt-5 text-center">
    <div class="mb-4">
        <i class="bi bi-shield-slash-fill text-danger" style="font-size: 4rem;"></i>
    </div>

    <h1 class="text-danger fw-bold uppercase">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h1>

    <div class="mt-3 max-w-md mx-auto">
        <p class="lead text-secondary">
            Bạn không có đủ quyền hạn để xem trang này. Vui lòng liên hệ quản trị viên.
        </p>
        <p class="text-muted font-monospace small bg-light d-inline-block px-3 py-1.5 rounded border">
            🔐 Quyền hạn hiện tại của bạn không khớp với yêu cầu của phân hệ này
        </p>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-primary px-4 py-2 fw-bold">
            <i class="bi bi-house-door-fill me-1"></i> Quay lại trang chủ
        </a>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger px-4 py-2 fw-bold">
            <i class="bi bi-box-arrow-left me-1"></i> Đăng xuất tài khoản này
        </a>
    </div>
</div>