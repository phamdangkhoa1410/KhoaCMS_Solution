@*
 * Sinh viên: Phạm Đăng Khoa
 * Mã Sinh Viên : 2123110058
 * Lớp: CCQ2311B - Trường Cao Đẳng Công Thương TP.HCM
 * Version 5.3 - Giao diện Đăng nhập Hệ thống độc lập chuẩn Tailwind UI cao cấp
*@

@{
    Layout = null; // Trang đăng nhập độc lập, không kế thừa thanh Sidebar của Layout chung
}

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - KHOA CMS</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="flex min-h-full items-center justify-center px-4 py-12 sm:px-6 lg:px-8 bg-slate-950 relative overflow-hidden">

    <div class="absolute top-0 -left-4 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob"></div>
    <div class="absolute bottom-0 -right-4 w-72 h-72 bg-sky-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-2000"></div>

    <div class="w-full max-w-md space-y-8 relative z-10">
        <div class="text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-500/30">
                <i class="bi bi-shield-lock-fill text-2xl"></i>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold tracking-tight text-white uppercase">
                KHOA<span class="text-indigo-500">-CMS</span> ADMIN
            </h2>
            <p class="mt-2 text-center text-sm text-slate-400">
                Hệ thống Quản trị Nội dung & Bán hàng Tích hợp
            </p>
        </div>

        <div class="mt-8 overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/50 p-6 sm:p-10 shadow-2xl backdrop-blur-md">
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-6">

                <div class="space-y-2">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Tên đăng nhập</label>
                    <div class="relative rounded-xl shadow-xs">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500">
                            <i class="bi bi-person-fill text-base"></i>
                        </div>
                        <input type="text" name="username" required
                               class="block w-full rounded-xl border border-slate-800 bg-slate-950/60 pl-11 pr-4 py-3.5 text-sm font-medium text-white outline-none transition-all placeholder:text-slate-600 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                               placeholder="Nhập tài khoản quản trị..." />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Mật khẩu</label>
                    <div class="relative rounded-xl shadow-xs">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500">
                            <i class="bi bi-lock-fill text-base"></i>
                        </div>
                        <input id="txtLoginPassword" type="password" name="password" required
                               class="block w-full rounded-xl border border-slate-200/5 bg-slate-950/60 pl-11 pr-12 py-3.5 text-sm font-medium text-white outline-none transition-all placeholder:text-slate-600 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                               placeholder="••••••••" />

                        <button type="button" onclick="toggleLoginPassword()"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-slate-500 hover:text-slate-300 transition-colors cursor-pointer focus:outline-none">
                            <i id="eyeLoginIcon" class="bi bi-eye-slash text-lg"></i>
                        </button>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="rounded-xl bg-rose-500/10 border border-rose-500/20 p-3.5 text-xs font-bold text-rose-400 flex items-center shadow-xs animate-shake">
                        <i class="bi bi-exclamation-triangle-fill mr-2.5 text-base text-rose-500"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <div>
                    <button type="submit"
                            class="flex w-full items-center justify-center rounded-xl bg-indigo-600 py-3.5 text-sm font-bold text-white shadow-lg shadow-indigo-500/20 transition-all duration-200 hover:bg-indigo-500 hover:shadow-indigo-500/30 active:scale-[0.98] cursor-pointer focus:outline-none">
                        <i class="bi bi-box-arrow-in-right mr-2 text-base"></i> ĐĂNG NHẬP HỆ THỐNG
                    </button>
                </div>
            </form>
        </div>

        <div class="text-center text-xs font-medium text-slate-600 space-y-1">
            <p class="m-0">&copy; 2026 - Phạm Đăng Khoa - MSV: 2123110058</p>
            <p class="font-mono text-[10px] text-slate-700">Lớp: CCQ2311B - Cao Đẳng Công Thương TP.HCM</p>
        </div>
    </div>

    <script>
        function toggleLoginPassword() {
            const passwordInput = document.getElementById("txtLoginPassword");
            const eyeIcon = document.getElementById("eyeLoginIcon");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.classList.remove("bi-eye-slash");
                eyeIcon.classList.add("bi-eye");
            } else {
                passwordInput.type = "password";
                eyeIcon.classList.remove("bi-eye");
                eyeIcon.classList.add("bi-eye-slash");
            }
        }
    </script>
</body>
</html>