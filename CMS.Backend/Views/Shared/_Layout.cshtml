<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KHOA-CMS Admin</title>

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4?v=@DateTime.Now.Ticks"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Tuỳ chỉnh thanh cuộn thanh mảnh theo style công nghiệp */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
    </style>
</head>
<body class="h-full overflow-hidden text-slate-900 antialiased">

    <div class="flex h-full w-full overflow-hidden">

        <aside class="flex h-full w-64 min-w-[264px] flex-col border-r border-slate-800 bg-slate-950 text-slate-400 shadow-xl flex-shrink-0">

            <a asp-controller="Home" asp-action="Index" class="flex h-16 items-center border-b border-slate-800 bg-slate-900/50 px-6 text-xl font-extrabold tracking-wide text-white no-underline">
                <i class="bi bi-cpu-fill text-sky-400 mr-2"></i>KHOA<span class="text-sky-400">-CMS</span>
            </a>

            <ul class="flex-1 space-y-1 overflow-y-auto p-4 m-0 list-none">
                <li class="list-none">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-speedometer2 text-lg mr-3 transition-colors group-hover:text-sky-400"></i> Trang chủ
                    </a>
                </li>
                <li class="list-none">
                    <a asp-controller="Category" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-tags text-lg mr-3 transition-colors group-hover:text-sky-400"></i> Danh mục
                    </a>
                </li>
                <li class="list-none">
                    <a asp-controller="Post" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-newspaper text-lg mr-3 transition-colors group-hover:text-sky-400"></i> Bài viết
                    </a>
                </li>
                <li class="list-none">
                    <a asp-controller="CategoryProduct" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-collection-fill text-lg mr-3 transition-colors group-hover:text-indigo-400"></i> Danh mục sản phẩm
                    </a>
                </li>
                <li class="list-none">
                    <a asp-controller="Product" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-box-seam text-lg mr-3 transition-colors group-hover:text-indigo-400"></i> Sản Phẩm
                    </a>
                </li>
                <li class="list-none">
                    <a asp-controller="User" asp-action="Index" class="flex items-center rounded-lg px-4 py-3 text-[14.5px] font-semibold text-slate-400 no-underline transition-all duration-200 hover:bg-slate-900 hover:text-white group">
                        <i class="bi bi-person-gear text-lg mr-3 transition-colors group-hover:text-sky-400"></i> Người dùng
                    </a>
                </li>
            </ul>

            <div class="border-t border-slate-800 bg-slate-900/50 p-4 text-xs">
                <div class="text-slate-500">Sinh viên thực hiện:</div>
                <div class="mt-0.5 font-bold text-white text-sm">Phạm Đăng Khoa</div>
                <span class="mt-1.5 inline-block rounded bg-slate-800 px-2 py-0.5 font-medium text-slate-400">Lớp: CCQ2311B</span>
            </div>
        </aside>

        <div class="flex flex-1 flex-col h-full overflow-hidden bg-slate-50">

            <header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-8 shadow-sm flex-shrink-0">
                <div>
                    <h5 class="m-0 text-sm font-bold tracking-wide text-slate-500 uppercase">Hệ thống Quản trị Nội dung</h5>
                </div>

                <div class="flex items-center gap-4">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="text-sm font-medium text-slate-600 flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-1.5">
                            <i class="bi bi-person-circle text-indigo-500 mr-2 text-base"></i>
                            <span>
                                Chào, <strong class="text-slate-900 font-bold">@User.FindFirst("FullName")?.Value</strong>
                                <span class="mx-1 text-slate-300">|</span>
                                <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-bold text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                                    @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                </span>
                            </span>
                        </div>

                        <a asp-controller="Account" asp-action="Logout" class="inline-flex items-center justify-center rounded-xl bg-rose-50 border border-rose-200 px-3.5 py-1.5 text-xs font-bold text-rose-600 no-underline shadow-xs transition-all duration-200 hover:bg-rose-600 hover:text-white cursor-pointer">
                            <i class="bi bi-box-arrow-right mr-1.5 text-sm"></i> Đăng xuất
                        </a>
                    }
                    else
                    {
                        <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-1.5 font-mono text-xs font-bold text-slate-700">
                            <i class="bi bi-person-badge text-sky-500 mr-1.5 text-sm"></i> MSSV: 2123110058
                        </div>
                    }
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-8">
                @RenderBody()
            </main>

            <footer class="border-t border-slate-200 bg-white px-8 py-3 text-center text-xs flex-shrink-0">
                <p class="m-0 font-bold text-slate-700">&copy; 2026 - Phạm Đăng Khoa - Cao Đẳng Công Thương TP.HCM</p>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>