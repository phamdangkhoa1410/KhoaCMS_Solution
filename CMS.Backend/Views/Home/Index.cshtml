@model IEnumerable<CMS.Data.Entities.Post>
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="space-y-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Xin chào, @ViewBag.FullName Phạm Đăng Khoa 👋</h1>
            <p class="mt-1 text-sm text-slate-500">Dưới đây là tổng quan số liệu hệ thống quản trị CMS của bạn ngày hôm nay.</p>
        </div>
        <span class="inline-flex items-center rounded-md bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 ring-1 ring-inset ring-sky-700/10">
            Hệ thống ổn định
        </span>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-xs transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Tổng số danh mục</p>
                    <h3 class="mt-2 text-3xl font-extrabold text-slate-900">@ViewBag.TotalCategories</h3>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-50 text-amber-500">
                    <i class="bi bi-tags-fill text-xl"></i>
                </div>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3">
                <a asp-controller="Category" asp-action="Index" class="text-xs font-bold text-amber-600 no-underline hover:text-amber-700">
                    Quản lý danh mục &rarr;
                </a>
            </div>
        </div>

        <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-xs transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Bài viết đã đăng</p>
                    <h3 class="mt-2 text-3xl font-extrabold text-slate-900">@ViewBag.TotalPosts</h3>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-sky-50 text-sky-500">
                    <i class="bi bi-newspaper text-xl"></i>
                </div>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3">
                <a asp-controller="Post" asp-action="Index" class="text-xs font-bold text-sky-600 no-underline hover:text-sky-700">
                    Xem tất cả bài viết &rarr;
                </a>
            </div>
        </div>

        <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-xs transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Tài khoản hệ thống</p>
                    <h3 class="mt-2 text-3xl font-extrabold text-slate-900">@ViewBag.TotalUsers</h3>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-emerald-50 text-emerald-500">
                    <i class="bi bi-people-fill text-xl"></i>
                </div>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3">
                <a asp-controller="User" asp-action="Index" class="text-xs font-bold text-emerald-600 no-underline hover:text-emerald-700">
                    Phân quyền tài khoản &rarr;
                </a>
            </div>
        </div>

    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-xs">
        <div class="border-b border-slate-100 px-6 py-4">
            <h3 class="text-base font-bold text-slate-900"><i class="bi bi-lightning-charge-fill text-amber-500 mr-1.5"></i>Bài viết vừa cập nhật nhanh</h3>
        </div>
        <div class="overflow-x-auto p-4">
            <table class="w-full text-left border-collapse m-0">
                <thead>
                    <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50/70">
                        <th class="p-3">ID</th>
                        <th class="p-3">Tiêu đề bài viết</th>
                        <th class="p-3">Ngày đăng</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var post in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="p-3 font-mono text-xs font-bold text-slate-400">#@post.Id</td>
                                <td class="p-3 text-sm font-semibold text-slate-800">@post.Title</td>
                                <td class="p-3 text-xs text-slate-500">@post.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="p-6 text-center text-sm text-slate-400 font-medium">Hệ thống chưa có bài viết nào. Hãy thêm bài viết mới nhé!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>