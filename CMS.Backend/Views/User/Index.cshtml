@model IEnumerable<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="text-dark fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i>QUẢN TRỊ NGƯỜI DÙNG</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-person-plus-fill"></i> THÊM TÀI KHOẢN
        </a>
    </div>

    <div class="table-responsive mt-4 bg-white p-3 rounded shadow-sm border">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Tài khoản</th>
                    <th>Họ và tên</th>
                    <th>Quyền hạn</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><b class="text-muted">#@item.Id</b></td>
                        <td><code class="fs-6">@item.Username</code></td>
                        <td class="fw-bold">@item.FullName</td>
                        <td>
                            @if (item.Role == "Quản trị viên")
                            {
                                <span class="badge bg-danger">@item.Role</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.Role</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirm('Xóa tài khoản này?')"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>