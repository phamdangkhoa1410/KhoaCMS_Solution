@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="mx-auto max-w-2xl">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl overflow-hidden">

        <div class="bg-indigo-600 px-6 py-4">
            <h4 class="m-0 text-base font-bold text-white flex items-center tracking-wide uppercase">
                <i class="bi bi-pencil-square mr-2 text-lg"></i> CẬP NHẬT TÀI KHOẢN
            </h4>
        </div>

        <div class="p-6 sm:p-8">
            <form asp-action="Edit" method="post" class="space-y-5 m-0">

                <input type="hidden" asp-for="Id" />

                <div class="space-y-1.5">
                    <label class="block text-sm font-bold text-slate-700">Mã số tài khoản (ID)</label>
                    <input class="block w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm font-mono font-bold text-slate-500 cursor-not-allowed select-none"
                           value="#@Model.Id" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-bold text-slate-700">Tên đăng nhập (Username)</label>
                    <input type="hidden" asp-for="Username" />
                    <input class="block w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm font-mono font-bold text-slate-500 cursor-not-allowed select-none"
                           value="@Model.Username" disabled />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-bold text-slate-700">Mật khẩu mới</label>
                    <input asp-for="PasswordHash" type="password" value=""
                           class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-hidden transition-all focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                           placeholder="Nhập mật khẩu mới nếu muốn thay đổi..." />
                    <p class="mt-1 text-xs text-slate-400 font-medium">💡 Gợi ý: Hãy để trống ô này nếu Khoa muốn giữ nguyên mật khẩu cũ của tài khoản.</p>
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-bold text-slate-700">Họ và tên</label>
                    <input asp-for="FullName"
                           class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-hidden transition-all placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10" />
                    <span asp-validation-for="FullName" class="block text-xs font-semibold text-rose-500"></span>
                </div>

                <div class="space-y-1.5">
                    <label class="block text-sm font-bold text-slate-700">Vai trò hệ thống</label>
                    <select asp-for="Role"
                            class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 outline-hidden transition-all focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10" required>
                        <option value="Biên tập viên">Biên tập viên</option>
                        <option value="Quản trị viên">Quản trị viên</option>
                    </select>
                    <span asp-validation-for="Role" class="block text-xs font-semibold text-rose-500"></span>
                </div>

                <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center gap-3">
                    <button type="submit" class="flex w-full sm:w-auto items-center justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 hover:shadow-md focus:outline-hidden cursor-pointer">
                        <i class="bi bi-save mr-1.5 text-base"></i> LƯU CẬP NHẬT
                    </button>

                    <a asp-action="Index" class="flex w-full sm:w-auto items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-bold text-slate-700 no-underline shadow-xs transition-all duration-200 hover:bg-slate-50 hover:text-slate-900 focus:outline-hidden">
                        <i class="bi bi-arrow-left mr-1.5"></i> QUAY LẠI
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>