@{
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 pb-5">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-950 tracking-tight uppercase flex items-center">
                <i class="bi bi-file-earmark-richtext text-sky-500 mr-2.5"></i>
                @(ViewBag.CurrentCategoryName ?? "DANH SÁCH BÀI VIẾT")
            </h2>
            <p class="mt-1 text-sm text-slate-500">Xem và quản lý các bài đăng tin tức thuộc phân hệ quản trị nội dung</p>
        </div>
        <div>
            <a asp-action="Create" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white no-underline shadow-sm transition-all duration-200 hover:bg-emerald-700 hover:shadow-md">
                <i class="bi bi-plus-circle mr-1.5 text-base"></i> Thêm bài viết mới
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in Model)
            {
                <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs group hover:shadow-md transition-all duration-200">

                    <div class="relative aspect-video w-full overflow-hidden bg-slate-100">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" alt="Post Thumbnail" />
                        }
                        else
                        {
                            <div class="flex h-full w-full items-center justify-center text-slate-400">
                                <i class="bi bi-image text-3xl"></i>
                            </div>
                        }
                    </div>

                    <div class="flex flex-1 flex-col p-5 space-y-3">
                        <div>
                            <span class="inline-flex items-center rounded-md bg-sky-50 px-2.5 py-1 text-xs font-bold text-sky-700 ring-1 ring-inset ring-sky-700/10">
                                @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </div>

                        <h3 class="font-bold text-slate-900 line-clamp-1 group-hover:text-sky-600 transition-colors text-base sm:text-lg m-0" title="@item.Title">
                            @item.Title
                        </h3>

                        <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed flex-1 m-0">@Html.Raw(item.Content)</p>

                        <div class="text-xs text-slate-400 font-medium pt-2 border-t border-slate-100">
                            <i class="bi bi-clock mr-1"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>

                        <div class="flex items-center gap-2 pt-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="inline-flex flex-1 items-center justify-center rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-bold text-sky-700 no-underline hover:bg-sky-100 transition-colors">
                                Xem chi tiết
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center justify-center rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-700 no-underline hover:bg-amber-100 transition-colors" title="Sửa">
                                Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               onclick="return confirm('Khoa có chắc chắn muốn xóa bài viết này không?')"
                               class="inline-flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700 no-underline hover:bg-rose-100 transition-colors" title="Xóa">
                                Xóa
                            </a>
                        </div>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-xs">
            <div class="flex flex-col items-center justify-center max-w-sm mx-auto">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-sky-50 text-sky-500 shadow-inner">
                    <i class="bi bi-file-earmark-richtext text-2xl"></i>
                </div>
                <h3 class="mt-4 text-base font-bold text-slate-900">Không tìm thấy bài viết!</h3>
                <p class="mt-1 text-sm text-slate-500 text-center">Hiện tại hệ thống không tìm thấy bài viết nào tương ứng với bộ lọc danh mục này.</p>
                <a asp-action="Create" class="mt-4 inline-flex items-center rounded-lg bg-sky-500 px-3.5 py-2 text-xs font-bold text-white no-underline shadow-xs hover:bg-sky-600 transition-colors">
                    Viết bài mới ngay
                </a>
            </div>
        </div>
    }

    @* GIAO DIỆN PHÂN TRANG (PAGINATION) *@
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <div class="mt-6 flex items-center justify-center">
            <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    var idParam = ViewBag.CategoryId != null ? $"id={ViewBag.CategoryId}&" : "";
                    if (i == ViewBag.CurrentPage)
                    {
                        <a href="?@(idParam)page=@i" aria-current="page" class="relative z-10 inline-flex items-center bg-sky-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 border border-sky-600">@i</a>
                    }
                    else
                    {
                        <a href="?@(idParam)page=@i" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 hover:text-sky-600 transition-colors focus:z-20">@i</a>
                    }
                }
            </nav>
        </div>
    }
</div>