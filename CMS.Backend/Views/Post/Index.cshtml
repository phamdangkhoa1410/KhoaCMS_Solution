@using CMS.Data.Entities
@model IEnumerable<Post>

@{
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container mt-4">
    <!-- Tiêu đề đỏ, in hoa giống image_b09c1e.png -->
    <h2 class="text-danger text-uppercase fw-bold mb-4">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0" style="border: 1px solid #eee !important;">
                    <!-- Ảnh Thumbnail -->
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail">

                    <div class="card-body">
                        <!-- Tiêu đề bài viết màu xanh -->
                        <h5 class="card-title text-primary fw-bold" style="font-size: 1.1rem;">@item.Title</h5>

                        <!-- Nội dung tóm tắt -->
                        <p class="card-text text-muted" style="font-size: 0.9rem;">
                            @if (item.Content.Length > 50)
                            {
                                @(item.Content.Substring(0, 50) + "...")
                            }
                            else
                            {
                                @item.Content
                            }
                        </p>

                        <!-- Ngày đăng -->
                        <p class="card-text">
                            <small class="text-secondary">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</small>
                        </p>

                        <!-- Nút xem chi tiết -->
                        <a href="#" class="btn btn-outline-primary btn-sm px-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>