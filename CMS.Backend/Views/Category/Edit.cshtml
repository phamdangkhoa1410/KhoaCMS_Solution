@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-header bg-primary text-white py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA DANH MỤC</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <!-- Quan trọng: Phải có Input ẩn để giữ lại ID khi gửi về Server -->
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Mã số danh mục (ID)</label>
                            <input class="form-control bg-light" value="#@Model.Id" readonly />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Tên danh mục</label>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-save"></i> CẬP NHẬT
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="bi bi-arrow-left"></i> QUAY LẠI
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>