@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-header bg-success text-white py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>THÊM DANH MỤC MỚI</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Tên danh mục</label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Tin Công Nghệ" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả ngắn gọn về danh mục này..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check-lg"></i> LƯU DỮ LIỆU
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="bi bi-arrow-left"></i> QUAY LẠI
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>