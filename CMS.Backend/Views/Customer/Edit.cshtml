@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="border-b border-slate-200 pb-4">
        <h2 class="text-2xl font-extrabold text-slate-950 tracking-tight">CẬP NHẬT HỒ SƠ KHÁCH HÀNG</h2>
        <p class="mt-1 text-sm text-slate-500">Thay đổi thông tin liên lạc, địa chỉ giao hàng hoặc mật khẩu tài khoản thành viên</p>
    </div>

    <form asp-action="Edit" method="post" class="space-y-5 bg-white border border-slate-200 p-6 rounded-2xl shadow-xs">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-sm font-bold text-rose-600 bg-rose-50 p-3 rounded-lg"></div>

        <div>
            <label asp-for="FullName" class="block text-sm font-bold text-slate-700 mb-2">Họ và tên khách hàng</label>
            <input asp-for="FullName" type="text" placeholder="Nhập tên khách hàng..." class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-500 focus:outline-none" />
            <span asp-validation-for="FullName" class="text-xs text-rose-600 mt-1 block font-semibold"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Email" class="block text-sm font-bold text-slate-700 mb-2">Hộp thư điện tử (Email)</label>
                <input asp-for="Email" type="email" placeholder="name@example.com" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-500 focus:outline-none" />
                <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block font-semibold"></span>
            </div>

            <div>
                <label asp-for="Phone" class="block text-sm font-bold text-slate-700 mb-2">Số điện thoại liên lạc</label>
                <input asp-for="Phone" type="text" placeholder="Nhập số điện thoại..." class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-500 focus:outline-none" />
                <span asp-validation-for="Phone" class="text-xs text-rose-600 mt-1 block font-semibold"></span>
            </div>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-bold text-slate-700 mb-2">Mật khẩu truy cập (Dạng thô tối giản)</label>
            <input asp-for="Password" type="text" placeholder="Cài đặt mật khẩu cho tài khoản..." class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm font-mono focus:border-sky-500 focus:outline-none" />
            <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block font-semibold"></span>
        </div>

        <div>
            <label asp-for="Address" class="block text-sm font-bold text-slate-700 mb-2">Địa chỉ đăng ký thường trú / Giao hàng</label>
            <textarea asp-for="Address" rows="3" placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..." class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-500 focus:outline-none"></textarea>
            <span asp-validation-for="Address" class="text-xs text-rose-600 mt-1 block font-semibold"></span>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
            <a asp-action="Index" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 no-underline shadow-sm hover:bg-slate-50 transition-colors">
                HỦY BỎ
            </a>
            <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-sky-600 transition-colors">
                CẬP NHẬT HỒ SƠ
            </button>
        </div>
    </form>
</div>