@model CMS.Data.Entities.Banner
@*
 * Sinh viên: Phạm Đăng Khoa
 * Mã Sinh Viên : 2123110058
 * Lớp: CCQ2311B - Trường Cao Đẳng Công Thương TP.HCM
 * Vị trí file: CMS.Backend/Views/Banner/Create.cshtml
 * Chức năng: Form thêm Banner mới — UPLOAD FILE ẢNH thật từ máy tính
 *            (Không dùng ô nhập link URL nữa — đã nâng cấp sang chọn file thực tế)
 *@


@{
    ViewData["Title"] = "Thêm Banner Mới";
}

<div class="mx-auto max-w-4xl">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">

        @* ─── HEADER FORM ─────────────────────────────────────────────────────── *@
        <div class="bg-violet-600 px-6 py-4">
            <h4 class="m-0 text-base font-bold text-white flex items-center tracking-wide">
                <i class="bi bi-plus-circle mr-2 text-lg"></i> THÊM BANNER MỚI
                <span class="ml-auto rounded-lg bg-white/20 px-2.5 py-1 text-xs font-semibold">Upload File Ảnh</span>
            </h4>
        </div>

        @* ─── THÔNG BÁO LỖI VALIDATION ──────────────────────────────────────── *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mx-6 mt-5 rounded-xl bg-rose-50 border border-rose-200 p-4 text-sm text-rose-700">
                <i class="bi bi-exclamation-triangle-fill mr-2 text-rose-500"></i>
                <strong>Vui lòng kiểm tra lại:</strong>
                <ul class="mt-2 mb-0 pl-5 space-y-0.5">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li class="font-medium">@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="p-6 sm:p-8">
            @* enctype="multipart/form-data" BẮT BUỘC để gửi file ảnh *@
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="m-0">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">

                    @* ═══ CỘT TRÁI (2/3): UPLOAD ẢNH + CÁC TRƯỜNG CHÍNH ═══ *@
                    <div class="lg:col-span-2 space-y-5 lg:border-r lg:border-slate-100 lg:pr-8">

                        @* ── ÔN CHỌN FILE ẢNH (THAY THẾ Ô NHẬP URL) ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">
                                <i class="bi bi-image-fill text-violet-500 mr-1.5"></i>
                                Ảnh Banner
                                <span class="ml-1 text-rose-500 font-bold">*</span>
                                <span class="ml-2 font-normal text-slate-400 text-xs">(JPG, PNG, WEBP — tối đa 10MB)</span>
                            </label>

                            @* VÙNG KÉO THẢ / BẤM CHỌN FILE *@
                            <div id="dropZone"
                                 class="relative flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 transition-all duration-200 cursor-pointer hover:border-violet-400 hover:bg-violet-50/40"
                                 style="min-height: 160px;"
                                 onclick="document.getElementById('imageFile').click()"
                                 ondragover="event.preventDefault(); this.classList.add('border-violet-500','bg-violet-50')"
                                 ondragleave="this.classList.remove('border-violet-500','bg-violet-50')"
                                 ondrop="handleDrop(event)">

                                @* Icon + chữ mặc định khi chưa chọn file *@
                                <div id="dropZoneDefault" class="text-center py-8 px-4">
                                    <i class="bi bi-cloud-arrow-up-fill text-slate-300 d-block" style="font-size: 2.5rem;"></i>
                                    <p class="mt-2 text-sm font-semibold text-slate-500">
                                        Kéo thả ảnh vào đây hoặc <span class="text-violet-600 underline">bấm để chọn file</span>
                                    </p>
                                    <p class="mt-0.5 text-xs text-slate-400">PNG, JPG, JPEG, WEBP, GIF · Tối đa 10MB</p>
                                </div>

                                @* Khu vực preview ảnh (ẩn mặc định, hiện khi chọn file) *@
                                <div id="previewContainer" class="hidden w-full h-full" style="min-height: 160px;">
                                    <img id="imgPreview"
                                         src=""
                                         alt="Preview banner"
                                         class="w-full rounded-xl object-cover"
                                         style="max-height: 220px;" />
                                    <div class="absolute bottom-2 right-2">
                                        <span id="fileNameBadge" class="inline-block rounded-lg bg-black/60 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm"></span>
                                    </div>
                                </div>
                            </div>

                            @* INPUT FILE ẨN — được trigger bằng JS *@
                            <input type="file"
                                   id="imageFile"
                                   name="imageFile"
                                   accept="image/*"
                                   class="hidden"
                                   onchange="handleFileSelect(this)" />
                        </div>

                        @* ── TIÊU ĐỀ ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">Tiêu đề Banner</label>
                            <input asp-for="Title"
                                   class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-hidden transition-all placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                                   placeholder="Ví dụ: Siêu phẩm Laptop Gaming 2026..." />
                        </div>

                        @* ── MÔ TẢ ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">Mô tả ngắn</label>
                            <textarea asp-for="Description"
                                      rows="3"
                                      class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-hidden transition-all placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10 resize-y"
                                      placeholder="Mô tả ngắn sẽ hiển thị dưới tiêu đề trên slider..."></textarea>
                        </div>

                        @* ── LINK ĐIỀU HƯỚNG ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">Link điều hướng khi click vào banner</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-3 flex items-center text-slate-400">
                                    <i class="bi bi-link-45deg text-base"></i>
                                </span>
                                <input asp-for="Link"
                                       class="block w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-9 pr-4 text-sm font-medium text-slate-900 outline-hidden transition-all placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                                       placeholder="/products  hoặc  /blogs  hoặc  https://..." />
                            </div>
                        </div>
                    </div>

                    @* ═══ CỘT PHẢI (1/3): VỊ TRÍ, TRẠNG THÁI, NÚT LƯU ═══ *@
                    <div class="space-y-5">

                        @* ── VỊ TRÍ SLIDER ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">
                                <i class="bi bi-sort-numeric-up text-slate-400 mr-1"></i>Thứ tự vị trí Slider
                            </label>
                            <input asp-for="Position"
                                   type="number"
                                   min="0"
                                   class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-hidden transition-all focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10" />
                            <p class="text-xs text-slate-400">Số nhỏ hơn = hiển thị trước. Mặc định: 0</p>
                        </div>

                        @* ── TRẠNG THÁI ── *@
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700">Trạng thái hiển thị</label>
                            <label class="relative inline-flex items-center cursor-pointer group">
                                <input asp-for="Status" type="checkbox" class="sr-only peer" checked />
                                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-violet-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-violet-600"></div>
                                <span class="ml-3 text-sm font-semibold text-slate-700 group-hover:text-violet-700">Bật hiển thị ngay</span>
                            </label>
                            <p class="text-xs text-slate-400">Bật = banner xuất hiện trên slider trang chủ React.</p>
                        </div>

                        @* ── NÚT HÀNH ĐỘNG ── *@
                        <div class="border-t border-slate-100 pt-5 space-y-2.5">
                            <button type="submit"
                                    id="btnSubmit"
                                    class="flex w-full items-center justify-center rounded-xl bg-violet-600 py-3 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:bg-violet-700 hover:shadow-md cursor-pointer">
                                <i class="bi bi-cloud-upload-fill mr-2"></i> UPLOAD & LƯU BANNER
                            </button>
                            <a asp-action="Index"
                               class="flex w-full items-center justify-center rounded-xl border border-slate-200 bg-white py-3 text-sm font-bold text-slate-700 no-underline shadow-xs transition-all duration-200 hover:bg-slate-50 hover:text-slate-900">
                                <i class="bi bi-x-circle mr-2"></i> HỦY BỎ
                            </a>
                        </div>

                        @* ── GHI CHÚ KỸ THUẬT ── *@
                        <div class="rounded-xl border border-violet-100 bg-violet-50 p-3 text-xs text-slate-500 space-y-1">
                            <div><i class="bi bi-lightbulb-fill text-violet-400 mr-1"></i><strong class="text-violet-700">Gợi ý tỷ lệ ảnh:</strong></div>
                            <div class="pl-4">• <strong>16:9</strong> (1920×1080px) — Lý tưởng nhất</div>
                            <div class="pl-4">• <strong>3:1</strong> (1200×400px) — Banner rộng</div>
                            <div class="mt-1"><i class="bi bi-shield-check text-emerald-400 mr-1"></i>File được lưu vào <code class="bg-slate-100 px-1 rounded">wwwroot/uploads/banners/</code></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Xử lý khi người dùng chọn file qua input ────────────────────────────
        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                showPreview(input.files[0]);
            }
        }

        // ── Xử lý kéo thả file vào vùng dropZone ───────────────────────────────
        function handleDrop(event) {
            event.preventDefault();
            document.getElementById('dropZone').classList.remove('border-violet-500', 'bg-violet-50');
            var files = event.dataTransfer.files;
            if (files && files[0]) {
                document.getElementById('imageFile').files = files; // Gán file vào input ẩn
                showPreview(files[0]);
            }
        }

        // ── Hiển thị preview ảnh và tên file ─────────────────────────────────────
        function showPreview(file) {
            var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp', 'image/bmp'];
            if (!allowedTypes.includes(file.type)) {
                alert('⚠️ Chỉ chấp nhận file ảnh: JPG, PNG, GIF, WEBP, BMP');
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                alert('⚠️ Kích thước file không được vượt quá 10MB.');
                return;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('fileNameBadge').textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
                document.getElementById('dropZoneDefault').classList.add('hidden');
                document.getElementById('previewContainer').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    </script>
}
